DATABASE_URL="postgresql://t4trips:t4trips@localhost:5433/t4trips?schema=public"
# Conexão sem pooler, usada só em migrações. Local é igual à DATABASE_URL.
DIRECT_URL="postgresql://t4trips:t4trips@localhost:5433/t4trips?schema=public"
PORT=3333
# Várias origens separadas por vírgula.
CORS_ORIGIN="http://localhost:8080"

# Mínimo de 16 caracteres cada. Gere valores aleatórios em produção.
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Endereço do frontend (links de recuperação de senha).
APP_URL="http://localhost:8080"
# Opcional em dev: sem chave, o link de recuperação sai no log da API.
RESEND_API_KEY=""
EMAIL_FROM="T4 Trips <nao-responda@t4trips.com.br>"

# Usadas só por prisma/seed.ts pra criar o primeiro administrador.
SEED_ADMIN_EMAIL="admin@t4trips.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"
