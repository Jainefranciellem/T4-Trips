generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Perfis da spec (seção 3). As permissões de cada perfil ficam em
// src/lib/permissions.ts — o mapa perfil→permissões é código, não dado, pra
// não ter como um perfil ficar sem permissão por falta de seed.
enum Role {
  ADMIN
  OPERADOR
  FINANCEIRO
  VISUALIZADOR
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum CustomerStatus {
  ATIVO
  ARQUIVADO
}

enum TripStatus {
  PLANEJADA
  ABERTA
  LOTADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  ARQUIVADA
}

// RF-013. PARCIALMENTE_PAGA, PAGA e ATRASADA passam a ser calculados pelos
// pagamentos (fase do financeiro); até lá ficam disponíveis só pela API.
enum ReservationStatus {
  PRE_RESERVA
  RESERVADA
  CONFIRMADA
  PARCIALMENTE_PAGA
  PAGA
  ATRASADA
  CANCELADA
  REEMBOLSADA
  LISTA_ESPERA
}

// RF-007
enum VehicleCategory {
  VAN
  MICRO_ONIBUS
  ONIBUS_CONVENCIONAL
  ONIBUS_EXECUTIVO
  ONIBUS_LD
  ONIBUS_LDD
  PERSONALIZADO
}

enum RecordStatus {
  ATIVO
  INATIVO
}

// Só LIVRE/BLOQUEADO ficam gravados. "Reservado" e "Confirmado" (spec 6.13)
// saem da reserva atribuída ao assento, pra nunca ficarem desencontrados.
enum TripSeatStatus {
  LIVRE
  BLOQUEADO
}

// RF-011
enum RoomType {
  INDIVIDUAL
  CASAL
  DUPLO
  TRIPLO
  QUADRUPLO
  QUINTUPLO
  SEXTUPLO
  PERSONALIZADO
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO
  TRANSFERENCIA
  OUTRO
}

// Só VALIDO/ESTORNADO ficam gravados; situação de parcela, reserva e despesa
// (pendente, parcial, pago, vencido) é calculada dos lançamentos válidos.
enum EntryStatus {
  VALIDO
  ESTORNADO
}

enum CustomerPaymentKind {
  PAGAMENTO
  REEMBOLSO
}

// Despesa fixa da viagem ou por passageiro (usado no ponto de equilíbrio).
enum CostType {
  FIXO
  POR_PESSOA
}

enum TripAccessLevel {
  VISUALIZAR
  OPERAR
}

// Valores monetários sempre em centavos (Int) — spec 7.1.
// Datas em timestamptz (DateTime do Prisma/Postgres já é UTC).

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  password_hash      String
  role               Role       @default(OPERADOR)
  status             UserStatus @default(ATIVO)
  // Permissão extra pra Visualizador/Operador ver CPF e dados sensíveis.
  can_view_sensitive Boolean    @default(false)
  failed_login_count Int        @default(0)
  locked_until       DateTime?
  last_login_at      DateTime?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  reservations    Reservation[]
  trips_access    TripUser[]
  trips           Trip[]               @relation("TripCreatedBy")
  audit_logs      AuditLog[]
  password_resets PasswordResetToken[]
}

// Recuperação de senha (RF-001). Só o hash do token fica no banco; o token em
// si vai no link do e-mail e vale uma vez.
model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Customer {
  id                      String         @id @default(uuid())
  full_name               String
  cpf                     String?        @unique
  birth_date              DateTime?      @db.Date
  whatsapp                String?
  phone                   String?
  email                   String?
  city                    String?
  state                   String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  guardian_name           String?
  guardian_phone          String?
  notes                   String?
  status                  CustomerStatus @default(ATIVO)
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  archived_at             DateTime?

  reservations  Reservation[]
  relationships CustomerRelationship[] @relation("CustomerOwner")
  related_to    CustomerRelationship[] @relation("CustomerRelated")

  @@index([full_name])
  @@index([phone])
  @@index([email])
}

model CustomerRelationship {
  id                  String   @id @default(uuid())
  customer_id         String
  related_customer_id String
  relationship_type   String
  group_name          String?
  created_at          DateTime @default(now())

  customer         Customer @relation("CustomerOwner", fields: [customer_id], references: [id])
  related_customer Customer @relation("CustomerRelated", fields: [related_customer_id], references: [id])

  @@unique([customer_id, related_customer_id])
}

model Trip {
  id                    String     @id @default(uuid())
  name                  String
  destination           String
  departure_at          DateTime
  return_at             DateTime
  departure_location    String
  commercial_capacity   Int
  default_package_price Int // centavos
  description           String?
  included_services     String?
  optional_services     String?
  internal_notes        String?
  public_instructions   String?
  cancellation_policy   String?
  cover_image_url       String?
  waitlist_enabled      Boolean    @default(false)
  // Configuração de vagas (RF-014) — usada quando as reservas forem implementadas.
  pending_holds_seat    Boolean    @default(true)
  reservation_ttl_hours Int?
  // true: pré-reserva vencida deixa de ocupar vaga sozinha; false: só ao cancelar.
  auto_release_holds    Boolean    @default(true)
  status                TripStatus @default(PLANEJADA)
  // Status antes de arquivar, pra "restaurar" voltar ao ponto certo.
  previous_status       TripStatus?
  created_by            String
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt
  archived_at           DateTime?
  cancelled_at          DateTime?

  creator      User          @relation("TripCreatedBy", fields: [created_by], references: [id])
  users        TripUser[]
  reservations Reservation[]
  vehicles       TripVehicle[]
  accommodations TripAccommodation[]
  expenses       TripExpense[]

  @@index([destination])
  @@index([departure_at])
  @@index([status])
}

// Quem pode enxergar/operar cada viagem (spec 6.9). ADMIN enxerga todas.
model TripUser {
  trip_id      String
  user_id      String
  access_level TripAccessLevel @default(OPERAR)

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([trip_id, user_id])
}

// Participação de um cliente numa viagem (RF-013). Uma reserva ativa por
// cliente e viagem: índice único parcial criado à mão na migração
// (reservations_one_active_per_customer), já que o Prisma não declara índice
// com WHERE.
model Reservation {
  id                 String            @id @default(uuid())
  trip_id            String
  customer_id        String
  reservation_status ReservationStatus @default(RESERVADA)
  // Cópia do nome no momento da reserva (RN-006): listas antigas não mudam se
  // o cadastro for editado depois. O vínculo com o cliente continua.
  passenger_name     String
  package_price      Int // centavos
  discount_amount    Int               @default(0)
  surcharge_amount   Int               @default(0)
  final_price        Int
  is_courtesy        Boolean           @default(false)
  payment_due_date   DateTime?         @db.Date
  // Prazo da pré-reserva (trip.reservation_ttl_hours).
  hold_expires_at    DateTime?
  notes              String?

  // RN-012: só o hash do token; o link aparece uma vez, ao gerar.
  public_token_hash       String?   @unique
  public_token_created_at DateTime?
  public_token_expires_at DateTime?
  public_token_revoked_at DateTime?

  created_by    String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  cancelled_at  DateTime?
  cancel_reason String?

  trip             Trip             @relation(fields: [trip_id], references: [id])
  customer         Customer         @relation(fields: [customer_id], references: [id])
  creator          User             @relation(fields: [created_by], references: [id])
  seat_assignments SeatAssignment[]
  room_assignments RoomAssignment[]
  payment_plan     PaymentPlan?
  payments         CustomerPayment[]

  @@index([trip_id])
  @@index([customer_id])
  @@index([reservation_status])
  @@map("reservations")
}

// Modelo reutilizável de veículo (spec 6.10). A capacidade é a do layout padrão.
model VehicleTemplate {
  id           String          @id @default(uuid())
  name         String
  category     VehicleCategory
  code         String?
  capacity     Int
  floors       Int             @default(1)
  aisle_config String?
  description  String?
  status       RecordStatus    @default(ATIVO)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  layouts       SeatLayout[]
  trip_vehicles TripVehicle[]

  @@map("vehicle_templates")
}

// layout_data: { floors: [{ floor, rows, cols }], seats: [{ floor, row, col,
// number, type, accessible, blocked }] } — validado em seat-layout.schema.ts.
model SeatLayout {
  id                  String   @id @default(uuid())
  vehicle_template_id String
  name                String
  version             Int      @default(1)
  layout_data         Json
  is_default          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  vehicle_template VehicleTemplate @relation(fields: [vehicle_template_id], references: [id])
  trip_vehicles    TripVehicle[]

  @@map("seat_layouts")
}

// Veículo usado numa viagem (spec 6.12). Os assentos são copiados do layout
// ao adicionar: editar o modelo depois não mexe em viagens já montadas.
model TripVehicle {
  id                   String       @id @default(uuid())
  trip_id              String
  vehicle_template_id  String
  seat_layout_id       String
  layout_version       Int
  operational_name     String
  identifier           String?
  driver_name          String?
  operational_capacity Int
  notes                String?
  status               RecordStatus @default(ATIVO)
  sort_order           Int          @default(0)
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  trip             Trip            @relation(fields: [trip_id], references: [id])
  vehicle_template VehicleTemplate @relation(fields: [vehicle_template_id], references: [id])
  seat_layout      SeatLayout      @relation(fields: [seat_layout_id], references: [id])
  seats            TripSeat[]

  @@index([trip_id])
  @@map("trip_vehicles")
}

model TripSeat {
  id              String         @id @default(uuid())
  trip_vehicle_id String
  seat_number     String
  floor           Int            @default(1)
  row             Int
  col             Int
  seat_type       String         @default("NORMAL")
  accessible      Boolean        @default(false)
  status          TripSeatStatus @default(LIVRE)
  blocked_reason  String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  trip_vehicle TripVehicle      @relation(fields: [trip_vehicle_id], references: [id], onDelete: Cascade)
  assignments  SeatAssignment[]

  @@unique([trip_vehicle_id, seat_number])
  @@index([trip_vehicle_id])
  @@map("trip_seats")
}

// Histórico de quem sentou onde (spec 6.19). Atribuição ativa = removed_at
// nulo; índices únicos parciais na migração garantem um passageiro por
// assento e um assento por reserva (RN-003).
model SeatAssignment {
  id             String    @id @default(uuid())
  reservation_id String
  trip_seat_id   String
  assigned_at    DateTime  @default(now())
  removed_at     DateTime?
  assigned_by    String

  reservation Reservation @relation(fields: [reservation_id], references: [id])
  trip_seat   TripSeat    @relation(fields: [trip_seat_id], references: [id])

  @@index([reservation_id])
  @@index([trip_seat_id])
  @@map("seat_assignments")
}

// Pousada reutilizável (spec 6.14). A capacidade total é a soma dos quartos
// ativos, calculada na leitura.
model Accommodation {
  id         String       @id @default(uuid())
  name       String
  address    String?
  city       String?
  state      String?
  phone      String?
  email      String?
  notes      String?
  status     RecordStatus @default(ATIVO)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  rooms               AccommodationRoom[]
  trip_accommodations TripAccommodation[]

  @@map("accommodations")
}

model AccommodationRoom {
  id               String       @id @default(uuid())
  accommodation_id String
  identifier       String
  name             String?
  room_type        RoomType
  capacity         Int
  beds             Int
  floor            String?
  notes            String?
  // RN-005: desativar não apaga o histórico.
  status           RecordStatus @default(ATIVO)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  accommodation Accommodation @relation(fields: [accommodation_id], references: [id])
  trip_rooms    TripRoom[]

  @@unique([accommodation_id, identifier])
  @@map("accommodation_rooms")
}

model TripAccommodation {
  id               String       @id @default(uuid())
  trip_id          String
  accommodation_id String
  notes            String?
  status           RecordStatus @default(ATIVO)
  created_at       DateTime     @default(now())

  trip          Trip          @relation(fields: [trip_id], references: [id])
  accommodation Accommodation @relation(fields: [accommodation_id], references: [id])
  rooms         TripRoom[]

  @@unique([trip_id, accommodation_id])
  @@map("trip_accommodations")
}

model TripRoom {
  id                    String       @id @default(uuid())
  trip_accommodation_id String
  accommodation_room_id String
  // Capacidade só nesta viagem (ex.: colchão extra); sem valor, vale a do quarto.
  capacity_override     Int?
  notes                 String?
  status                RecordStatus @default(ATIVO)
  created_at            DateTime     @default(now())

  trip_accommodation TripAccommodation @relation(fields: [trip_accommodation_id], references: [id], onDelete: Cascade)
  accommodation_room AccommodationRoom @relation(fields: [accommodation_room_id], references: [id])
  assignments        RoomAssignment[]

  @@unique([trip_accommodation_id, accommodation_room_id])
  @@map("trip_rooms")
}

// spec 6.20. Ativa = removed_at nulo; índice único parcial na migração garante
// um quarto ativo por reserva (RN-005).
model RoomAssignment {
  id             String    @id @default(uuid())
  reservation_id String
  trip_room_id   String
  assigned_at    DateTime  @default(now())
  removed_at     DateTime?
  assigned_by    String

  reservation Reservation @relation(fields: [reservation_id], references: [id])
  trip_room   TripRoom    @relation(fields: [trip_room_id], references: [id])

  @@index([reservation_id])
  @@index([trip_room_id])
  @@map("room_assignments")
}

// Arquivo enviado (comprovantes). spec 6.29: privado, com checksum.
model StoredFile {
  id            String    @id @default(uuid())
  storage_key   String    @unique
  original_name String
  mime_type     String
  size          Int
  checksum      String
  uploaded_by   String
  created_at    DateTime  @default(now())
  deleted_at    DateTime?

  customer_payments CustomerPayment[]
  expense_payments  ExpensePayment[]
  expenses          TripExpense[]

  @@map("files")
}

// spec 6.21/6.22. O valor pago de cada parcela é calculado distribuindo os
// pagamentos válidos em ordem de vencimento.
model PaymentPlan {
  id             String   @id @default(uuid())
  reservation_id String   @unique
  total_amount   Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  reservation  Reservation          @relation(fields: [reservation_id], references: [id])
  installments PaymentInstallment[]

  @@map("payment_plans")
}

model PaymentInstallment {
  id                 String   @id @default(uuid())
  payment_plan_id    String
  installment_number Int
  due_date           DateTime @db.Date
  amount             Int

  plan PaymentPlan @relation(fields: [payment_plan_id], references: [id], onDelete: Cascade)

  @@unique([payment_plan_id, installment_number])
  @@map("payment_installments")
}

// spec 6.23. Nunca apagado (RN-008): estorno muda o status e guarda o motivo.
model CustomerPayment {
  id              String              @id @default(uuid())
  reservation_id  String
  kind            CustomerPaymentKind @default(PAGAMENTO)
  amount          Int
  payment_date    DateTime            @db.Date
  payment_method  PaymentMethod
  reference       String?
  receipt_file_id String?
  status          EntryStatus         @default(VALIDO)
  created_by      String
  created_at      DateTime            @default(now())
  reversed_at     DateTime?
  reversed_by     String?
  reversal_reason String?

  reservation Reservation @relation(fields: [reservation_id], references: [id])
  receipt     StoredFile? @relation(fields: [receipt_file_id], references: [id])

  @@index([reservation_id])
  @@map("customer_payments")
}

model ExpenseCategory {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  is_system   Boolean      @default(false)
  status      RecordStatus @default(ATIVO)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  expenses TripExpense[]

  @@map("expense_categories")
}

model TripExpense {
  id              String    @id @default(uuid())
  trip_id         String
  category_id     String
  description     String
  supplier_name   String?
  cost_type       CostType  @default(FIXO)
  planned_amount  Int
  due_date        DateTime? @db.Date
  notes           String?
  receipt_file_id String?
  created_by      String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  cancelled_at    DateTime?
  cancel_reason   String?

  trip     Trip             @relation(fields: [trip_id], references: [id])
  category ExpenseCategory  @relation(fields: [category_id], references: [id])
  receipt  StoredFile?      @relation(fields: [receipt_file_id], references: [id])
  payments ExpensePayment[]

  @@index([trip_id])
  @@map("trip_expenses")
}

model ExpensePayment {
  id              String        @id @default(uuid())
  expense_id      String
  amount          Int
  payment_date    DateTime      @db.Date
  payment_method  PaymentMethod
  reference       String?
  receipt_file_id String?
  status          EntryStatus   @default(VALIDO)
  created_by      String
  created_at      DateTime      @default(now())
  reversed_at     DateTime?
  reversed_by     String?
  reversal_reason String?

  expense TripExpense @relation(fields: [expense_id], references: [id])
  receipt StoredFile? @relation(fields: [receipt_file_id], references: [id])

  @@index([expense_id])
  @@map("expense_payments")
}

model AuditLog {
  id          String   @id @default(uuid())
  user_id     String?
  entity_type String
  entity_id   String
  action      String
  old_values  Json?
  new_values  Json?
  reason      String?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([created_at])
}
